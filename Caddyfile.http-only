# ==============================================
# GRAFIKARSA — Varian HTTP-only (shared host)
# ==============================================
# Dipakai HANYA jika server berbagi port 80/443 dengan Nginx host
# (mis. satu VPS menampung banyak aplikasi).
# TLS di-terminate di Nginx host (certbot), Caddy hanya routing internal.
# Dipilih via .env:  CADDYFILE=./Caddyfile.http-only
#                    PROXY_HTTP_PORT=8081
# Server fresh/dedicated TETAP pakai ./Caddyfile (auto HTTPS).
#
# Routing sama persis dengan Caddyfile utama.

http://{$DOMAIN} {
	encode gzip

	request_body {
		max_size 50MB
	}

	# Backend API — internal only, tanpa URL publik terpisah
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Object storage publik via path (strip /storage -> MinIO /bucket/key)
	handle_path /storage/* {
		reverse_proxy minio:9000
	}

	# Frontend
	handle {
		reverse_proxy web:3100
	}
}
