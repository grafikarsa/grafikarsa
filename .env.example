# ══════════════════════════════════════════════
# GRAFIKARSA — Environment Variables
# ══════════════════════════════════════════════
#
# LOKAL:   cp .env.example .env, lalu: make dev
# SERVER:  cukup DOMAIN + password + JWT secret (lihat bawah).
#          API & storage TIDAK punya subdomain — semua nunut 1 domain:
#            https://DOMAIN/          -> frontend
#            https://DOMAIN/api/*     -> backend (internal only)
#            https://DOMAIN/storage/* -> MinIO (publik read)
#
# This single .env file is used by:
#   - Docker Compose (db, minio, backend containers)
#   - Next.js web app (npm run dev reads NEXT_PUBLIC_* vars)
#   - Makefile (reads all vars)
#
# ⚠️  NEVER commit .env to git!

# ──────────────────────────────────────────────
# 🌍 DOMAIN (deploy only — di lokal diabaikan)
# ──────────────────────────────────────────────
# Domain ATAU IP server. Contoh: grafikarsa.com / 103.134.78.58
# IP = otomatis HTTP. Domain valid = Caddy otomatis HTTPS (Let's Encrypt).
DOMAIN=localhost

# ──────────────────────────────────────────────
# 🔧 APP
# ──────────────────────────────────────────────
APP_ENV=development
NODE_ENV=development

# ──────────────────────────────────────────────
# 🗄️  DATABASE (PostgreSQL)
# ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=grafikarsa
DB_PASSWORD=grafikarsa123
DB_NAME=grafikarsa
DB_SSLMODE=disable

# ──────────────────────────────────────────────
# 📦 MINIO (Object Storage / file uploads)
# ──────────────────────────────────────────────
# Lokal: direct localhost:9000. Server: internal minio:9000,
# browser akses via https://DOMAIN/storage/... (lihat Caddyfile).
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=grafikarsa
MINIO_USE_SSL=false
MINIO_PRESIGN_HOST=localhost:9000
MINIO_PRESIGN_USE_SSL=false
# WAJIB /storage di server (proxy strip prefix). Kosongkan hanya untuk
# setup subdomain lama (tidak direkomendasikan).
MINIO_PRESIGN_PATH_PREFIX=
STORAGE_PUBLIC_URL=http://localhost:9000/grafikarsa
#
# CONTOH SERVER (single-domain, DOMAIN=grafikarsa.com):
#   MINIO_ENDPOINT=minio:9000
#   MINIO_PRESIGN_HOST=grafikarsa.com
#   MINIO_PRESIGN_USE_SSL=true
#   MINIO_PRESIGN_PATH_PREFIX=/storage
#   STORAGE_PUBLIC_URL=https://grafikarsa.com/storage/grafikarsa
#
# CONTOH SERVER TANPA DOMAIN (DOMAIN=1.2.3.4):
#   MINIO_PRESIGN_HOST=1.2.3.4
#   MINIO_PRESIGN_USE_SSL=false
#   STORAGE_PUBLIC_URL=http://1.2.3.4/storage/grafikarsa

# ──────────────────────────────────────────────
# 🔑 JWT (Authentication tokens)
# ──────────────────────────────────────────────
# Generate secrets:  openssl rand -base64 32
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-prod
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-prod
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ──────────────────────────────────────────────
# 🌐 CORS (allowed origins, comma-separated)
# ──────────────────────────────────────────────
# Server single-domain cukup 1 origin (same-origin /api).
# Contoh server: CORS_ORIGINS=https://grafikarsa.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ──────────────────────────────────────────────
# 🖥️  NEXT.JS (frontend)
# ──────────────────────────────────────────────
# These are read by both Next.js and Docker build.
# Lokal: seperti di bawah. Server (DOMAIN=grafikarsa.com):
#   NEXT_PUBLIC_API_URL=https://grafikarsa.com/api/v1
#   NEXT_PUBLIC_APP_URL=https://grafikarsa.com
#   NEXT_PUBLIC_STORAGE_URL=https://grafikarsa.com/storage/grafikarsa
# Server tanpa domain (DOMAIN=1.2.3.4): sama, tapi http://.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORAGE_URL=http://localhost:9000/grafikarsa
NEXT_PUBLIC_MAINTENANCE_MODE=false

# SSR internal API (Docker-only, server-side). Mencegah EAI_AGAIN karena
# container web tidak bisa resolve hostname publik. Kosongkan = fallback ke NEXT_PUBLIC_API_URL.
INTERNAL_API_URL=http://backend:8080/api/v1

# ──────────────────────────────────────────────
# 🔒 ADMIN
# ──────────────────────────────────────────────
ADMIN_LOGIN_PATH=loginadmin

# ──────────────────────────────────────────────
# 🐳 DOCKER HUB (only needed for CI/CD & deploy)
# ──────────────────────────────────────────────
DOCKERHUB_USERNAME=your_dockerhub_username

# ──────────────────────────────────────────────
# ⚡ RATE LIMITING
# ──────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION=1m

# ──────────────────────────────────────────────
# 🔧 DEBUG (DEVELOPMENT ONLY)
# ──────────────────────────────────────────────
# Enable debug mode to test empty states and UI components
# ⚠️ WARNING: Only use in development, never in production!
NEXT_PUBLIC_DEBUG_MODE=false

# ──────────────────────────────────────────────
# 🤖 AI (Google Gemini)
# ──────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Enable/disable AI features (project ideas generator)
NEXT_PUBLIC_AI_FEATURES_ENABLED=true

# ──────────────────────────────────────────────
# 🔴 REDIS (Cache)
# ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0