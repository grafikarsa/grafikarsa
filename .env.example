# --- PostgreSQL ---
POSTGRES_USER=grafikarsa
POSTGRES_PASSWORD=__RANDOM__
POSTGRES_DB=grafikarsa
# --- Valkey ---
VALKEY_PASSWORD=__RANDOM__
# --- RustFS (S3) ---
RUSTFS_ACCESS_KEY=__RANDOM__
RUSTFS_SECRET_KEY=__RANDOM__
# --- Port dev (selalu bind ke 127.0.0.1) ---
DB_PORT=5439
VALKEY_PORT=6391
RUSTFS_PORT=9020
RUSTFS_CONSOLE_PORT=9021
API_PORT=8091
WEB_PORT=3020
# --- API ---
GK_ENV=development
GK_HTTP_ADDR=:8091
GK_LOG_LEVEL=debug
GK_ALLOWED_ORIGINS=http://localhost:3020
GK_SECRET_KEY=__RANDOM__
DATABASE_URL=postgres://grafikarsa:__POSTGRES_PASSWORD__@localhost:5439/grafikarsa?sslmode=disable
VALKEY_URL=redis://:__VALKEY_PASSWORD__@localhost:6391/0
S3_ENDPOINT=http://localhost:9020
S3_REGION=us-east-1
S3_ACCESS_KEY=__RUSTFS_ACCESS_KEY__
S3_SECRET_KEY=__RUSTFS_SECRET_KEY__
S3_BUCKET_PRIVATE=gk-private
S3_BUCKET_PUBLIC=gk-public
# --- Web ---
API_INTERNAL_URL=http://localhost:8091
NEXT_PUBLIC_SITE_URL=http://localhost:3020
