# ══════════════════════════════════════════════
# GRAFIKARSA v2 — Environment Variables
# ══════════════════════════════════════════════
#
# SATU-SATUNYA env. Dibaca oleh: docker compose, Go API,
# Next.js (hanya NEXT_PUBLIC_*), Makefile, dan tools/.
#
# LOKAL:   cp .env.example .env, lalu: make dev
# SERVER:  isi via tools/server-init.sh (generate secret otomatis)
#
# Generate secret:  openssl rand -base64 32
# ⚠️  NEVER commit .env to git!

# ──────────────────────────────────────────────
# 🌍 DOMAIN (deploy only — di lokal diabaikan)
# ──────────────────────────────────────────────
DOMAIN=localhost

# ──────────────────────────────────────────────
# 🔧 APP
# ──────────────────────────────────────────────
APP_ENV=development

# ──────────────────────────────────────────────
# 🗄️  DATABASE (PostgreSQL)
# ──────────────────────────────────────────────
DB_USER=grafikarsa
DB_PASSWORD=<rand: openssl rand -base64 32>
DB_NAME=grafikarsa
DB_PORT=5432
# Host internal compose di-override di docker-compose.yml (DB_HOST=db).
# Diisi di sini hanya untuk tools host-side (psql, migrate, seed).
DB_HOST=localhost

# ──────────────────────────────────────────────
# 📦 OBJECT STORAGE (S3-compatible, agnostik vendor)
# ──────────────────────────────────────────────
# Default: RustFS self-host (service `storage:` di compose).
# Ganti ke R2/S3/MinIO: ubah 5 var S3_* + restart, tanpa ubah kode.
#
# Dev di host (browser/tools):  http://localhost:9000
# Dev di dalam container (API): http://storage:9000 (di-override compose)
S3_ENDPOINT=http://localhost:9000
# R2 pakai `auto`; AWS pakai region bucket (cth. ap-southeast-1)
S3_REGION=us-east-1
S3_BUCKET=grafikarsa
S3_ACCESS_KEY=<rand>
S3_SECRET_KEY=<rand: openssl rand -base64 32>
S3_USE_PATH_STYLE=true
# Base URL publik via BFF — BUKAN host storage (storage tidak diekspos).
# Lokal:  http://localhost:3000/api/media
# Server: https://DOMAIN/api/media
S3_PUBLIC_URL=http://localhost:3000/api/media

# ──────────────────────────────────────────────
# ⚡ DRAGONFLY (cache, RESP-compatible)
# ──────────────────────────────────────────────
# Internal only. Di-override compose (DRAGONFLY_HOST=dragonfly).
DRAGONFLY_HOST=localhost
DRAGONFLY_PORT=6379
DRAGONFLY_PASSWORD=
DRAGONFLY_DB=0

# ──────────────────────────────────────────────
# 🔑 JWT + SESSION
# ──────────────────────────────────────────────
JWT_ACCESS_SECRET=<rand: openssl rand -base64 32>
JWT_REFRESH_SECRET=<rand: openssl rand -base64 32>
JWT_ACCESS_TTL=15m
# Refresh: 30 hari absolut + 7 hari idle (sliding).
REFRESH_ABSOLUTE_TTL=720h
REFRESH_IDLE_TTL=168h
CSRF_SECRET=<rand: openssl rand -base64 32>

# ──────────────────────────────────────────────
# 🛡️  TURNSTILE (Cloudflare, anti-bots login/feedback)
# ──────────────────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ──────────────────────────────────────────────
# 🖥️  NEXT.JS (frontend)
# ──────────────────────────────────────────────
# SSR internal: container web -> API via docker DNS (mencegah EAI_AGAIN).
# Dev native (pnpm dev):      http://localhost:8080/v1
# Compose/prod (dalam Docker): http://api:8080/v1 (di-override compose)
INTERNAL_API_URL=http://localhost:8080/v1
# Lokal: seperti di bawah. Server: https://DOMAIN
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ──────────────────────────────────────────────
# 👤 SEED ADMIN (dipakai `make seed` sekali)
# ──────────────────────────────────────────────
ADMIN_SEED_EMAIL=admin@grafikarsa.com
ADMIN_SEED_PASSWORD=<rand, wajib ganti setelah seed pertama>

# ──────────────────────────────────────────────
# 🐳 DOCKER HUB (CI/CD & deploy)
# ──────────────────────────────────────────────
DOCKERHUB_USERNAME=rafapradana
# Di-override CI ke short-sha. Jangan set manual di server.
IMAGE_TAG=latest

# ──────────────────────────────────────────────
# 💾 BACKUP (volume host /opt/grafikarsa/backup)
# ──────────────────────────────────────────────
BACKUP_S3_PATH=/backup
